@using System.Text.Json
@model global::TaskScheduler.Client.ViewModels.Home.IndexViewModel
@{
    ViewData["Title"] = "Task Scheduler Management";
    var pageConfigJson = JsonSerializer.Serialize(Model, new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<div class="container-fluid full-height-container mt-3">
    <div id="gridTasks"></div>
    <div id="popupHistory"></div>
    <div id="popupStepLogs"></div>
    <div id="popupStepRequestTest"></div>
</div>

@section Styles {
    <style>
        .step-test-popup {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .step-test-summary {
            display: grid;
            gap: 6px;
        }

        .step-test-section {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .step-test-section-title {
            font-weight: 600;
        }

        .step-test-pre {
            margin: 0;
            padding: 12px;
            border: 1px solid #d7dde5;
            border-radius: 6px;
            background-color: #f7f9fc;
            max-height: 220px;
            overflow: auto;
            white-space: pre-wrap;
            word-break: break-word;
            font-size: 12px;
            line-height: 1.5;
        }

        .step-test-hint {
            color: #5c6670;
            font-size: 12px;
            line-height: 1.5;
        }

        .step-test-error {
            color: #b42318;
            font-weight: 600;
        }
    </style>
}

@section Scripts {
    <script src="~/js/scheduler-editor.js"></script>
    <script src="~/js/schedule-grid-editor.js"></script>
    <script>
        $(function () {
            var pageConfig = @Html.Raw(pageConfigJson);
            var serviceUrl = pageConfig.apiBaseUrl;
            var hubUrl = pageConfig.hubUrl;
            var schedulerRules = window.TaskSchedulerScheduler.createHelpers(pageConfig.scheduleEditor);
            var scheduleGridEditor = window.TaskSchedulerScheduleGrid.create({
                serviceUrl: serviceUrl,
                schedulerRules: schedulerRules
            });
            var stepRequestEchoUrl = new URL("RequestTest/Echo", serviceUrl).toString();

            // ============ STORES ============
            var tasksStore = DevExpress.data.AspNet.createStore({
                key: "Id",
                loadUrl: serviceUrl + "Tasks/Get",
                insertUrl: serviceUrl + "Tasks/Post",
                updateUrl: serviceUrl + "Tasks/Put",
                deleteUrl: serviceUrl + "Tasks/Delete",
                onBeforeSend: function (method, ajaxOptions) {
                    ajaxOptions.xhrFields = { withCredentials: true };
                }
            });

            var stepsStore = DevExpress.data.AspNet.createStore({
                key: "Id",
                loadUrl: serviceUrl + "Steps/Get",
                insertUrl: serviceUrl + "Steps/Post",
                updateUrl: serviceUrl + "Steps/Put",
                deleteUrl: serviceUrl + "Steps/Delete",
                onBeforeSend: function (method, ajaxOptions) {
                    ajaxOptions.xhrFields = { withCredentials: true };
                }
            });

            var logsStore = DevExpress.data.AspNet.createStore({
                key: "Id",
                loadUrl: serviceUrl + "TaskExecutionLogs/Get",
                onBeforeSend: function (method, ajaxOptions) {
                    ajaxOptions.xhrFields = { withCredentials: true };
                }
            });

            var stepLogsStore = DevExpress.data.AspNet.createStore({
                key: "Id",
                loadUrl: serviceUrl + "StepExecutionLogs/Get",
                onBeforeSend: function (method, ajaxOptions) {
                    ajaxOptions.xhrFields = { withCredentials: true };
                }
            });

            var connection = new signalR.HubConnectionBuilder()
                .withUrl(hubUrl)
                .withAutomaticReconnect()
                .build();


                connection.on("ReceiveTaskUpdate", function (taskId, data) {
                    console.log("SignalR Update Received:", taskId);
                    console.log("Data Update:", data);
                    // ใช้ความสามารถ push ของ Store เพื่ออัปเดตข้อมูลใน Grid ทันทีโดยไม่ต้องโหลดใหม่
                    tasksStore.push([{
                        type: "update",
                        key: taskId,
                        data: data // ข้อมูล object ที่ส่งมาจาก Backend (LastStatus, LastRun, NextRun)
                    }]);
                });

            // เริ่มการเชื่อมต่อ
            connection.start().then(function () {
                console.log("SignalR Connected!");
            }).catch(function (err) {
                return console.error(err.toString());
            });

            function extractApiErrorMessage(error) {
                var responseJson = error && (error.responseJSON || (error.xhr && error.xhr.responseJSON));
                if (responseJson) {
                    if (responseJson.message) {
                        return responseJson.message;
                    }

                    if (Array.isArray(responseJson.errors) && responseJson.errors.length) {
                        return responseJson.errors
                            .map(function(item) { return item.message || item.Message; })
                            .filter(Boolean)
                            .join("\n");
                    }
                }

                return error && error.responseText
                    ? error.responseText
                    : "Request test failed.";
            }

            function formatStructuredValue(value) {
                if (value === null || value === undefined || value === "") {
                    return "(empty)";
                }

                if (typeof value === "string") {
                    var text = value.trim();
                    if (!text.length) {
                        return "(empty)";
                    }

                    try {
                        return JSON.stringify(JSON.parse(text), null, 2);
                    } catch (error) {
                        return value;
                    }
                }

                return JSON.stringify(value, null, 2);
            }

            function appendStepTestSection(container, title, value) {
                $("<div>")
                    .addClass("step-test-section")
                    .append($("<div>").addClass("step-test-section-title").text(title))
                    .append($("<pre>").addClass("step-test-pre").text(formatStructuredValue(value)))
                    .appendTo(container);
            }

            function showStepRequestTestResult(stepName, envelope) {
                var payload = envelope.data || envelope.Data || {};
                var request = payload.request || payload.Request || {};
                var response = payload.response || payload.Response || {};

                $("#popupStepRequestTest").dxPopup({
                    title: "Request Test: " + (stepName || payload.stepName || payload.StepName || "Step"),
                    visible: true,
                    showTitle: true,
                    width: 960,
                    maxHeight: 760,
                    height: "auto",
                    contentTemplate: function(content) {
                        var wrapper = $("<div>").addClass("step-test-popup");
                        var statusText = response.statusCode || response.StatusCode
                            ? (response.statusCode || response.StatusCode) + " " + (response.reasonPhrase || response.ReasonPhrase || "")
                            : "No HTTP response";

                        $("<div>")
                            .addClass("step-test-summary")
                            .append($("<div>").text("Target URL: " + (request.url || request.Url || "")))
                            .append($("<div>").text("Method: " + (request.method || request.Method || "")))
                            .append($("<div>").text("HTTP Status: " + statusText.trim()))
                            .append($("<div>").text("Duration: " + (payload.durationMs || payload.DurationMs || 0) + " ms"))
                            .appendTo(wrapper);

                        if (response.errorMessage || response.ErrorMessage) {
                            $("<div>")
                                .addClass("step-test-error")
                                .text("Transport Error: " + (response.errorMessage || response.ErrorMessage))
                                .appendTo(wrapper);
                        }

                        appendStepTestSection(wrapper, "Request Headers", request.headers || request.Headers);
                        appendStepTestSection(wrapper, "Request Body", request.body || request.Body);
                        appendStepTestSection(wrapper, "Response Headers", response.headers || response.Headers);
                        appendStepTestSection(wrapper, "Response Body", response.body || response.Body);

                        wrapper.appendTo(content);
                    }
                }).dxPopup("instance").show();
            }

            function runStepRequestTest(stepData) {
                var payload = {
                    name: stepData.Name || stepData.name || "",
                    apiUrl: stepData.ApiUrl || stepData.apiUrl || "",
                    httpMethod: stepData.HttpMethod || stepData.httpMethod || "GET",
                    headers: stepData.Headers || stepData.headers || "",
                    body: stepData.Body || stepData.body || ""
                };

                return $.ajax({
                    url: serviceUrl + "StepRequestTests/Run",
                    method: "POST",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify(payload),
                    xhrFields: {
                        withCredentials: true
                    }
                }).then(function(response) {
                    DevExpress.ui.notify("Request test completed.", "success", 2000);
                    showStepRequestTestResult(payload.name, response);
                    return response;
                }, function(error) {
                    DevExpress.ui.notify(extractApiErrorMessage(error), "error", 4000);
                    throw error;
                });
            }

            function getCurrentStepFormData(stepForm) {
                var formData = $.extend({}, stepForm.option("formData") || {});
                var popupContent = $(".dx-overlay-content:visible .dx-popup-content").last();

                function readPopupValue(selector, fallbackValue) {
                    var editor = popupContent.find(selector).first();
                    return editor.length ? editor.val() : fallbackValue;
                }

                ["Name", "ApiUrl", "HttpMethod", "Headers", "Body"].forEach(function(fieldName) {
                    var editor = stepForm.getEditor(fieldName);
                    if (editor) {
                        formData[fieldName] = editor.option("value");
                    }
                });

                formData.Name = readPopupValue("input.dx-texteditor-input[role='textbox']", formData.Name || "");
                formData.ApiUrl = readPopupValue("input.dx-texteditor-input[placeholder='e.g. https://localhost:7253/api/RequestTest/Echo']", formData.ApiUrl || "");
                formData.HttpMethod = readPopupValue("input.dx-texteditor-input[role='combobox']", formData.HttpMethod || "GET");
                formData.Headers = readPopupValue("textarea.dx-texteditor-input[placeholder='Authorization: Bearer token\nX-Test-Id: sample\nContent-Type: application/json']", formData.Headers || "");
                formData.Body = readPopupValue("textarea.dx-texteditor-input[placeholder='{" + '"sample"' + ":true}']", formData.Body || "");

                return formData;
            }

            // ============ MAIN GRID ============
            $("#gridTasks").dxDataGrid({
                dataSource: tasksStore,
                remoteOperations: true,
                showBorders: true,
                columnAutoWidth: true,
                rowAlternationEnabled: true,
                height: "100%",
                scrolling: { mode: "virtual" },

                searchPanel: {
                    visible: true,
                    width: 240,
                    placeholder: "Search..."
                },

                headerFilter: {
                    visible: true
                },

                filterRow: {
                    visible: true
                },

             
                // Master-Detail
                masterDetail: {
                    enabled: true,
                    template: function(container, options) {
                        var taskId = options.key;

                        $("<div>").dxTabPanel({
                            items: [
                                {
                                    title: "Steps",
                                    template: function(data, index, element) {
                                        createStepsGrid(element, taskId);
                                    }
                                },
                                {
                                    title: "Schedules",
                                    template: function(data, index, element) {
                                        createTriggersGrid(element, taskId);
                                    }
                                }
                            ],
                            height: 400
                        }).appendTo(container);
                    }
                },

                // Editing
                editing: {
                    mode: "popup",
                    allowAdding: true,
                    allowUpdating: true,
                    allowDeleting: true,
                    useIcons: true,
                    popup: {
                        title: "Task Information",
                        showTitle: true,
                            width: 800,
                            height: 650
                    },
                    form: {
                        items: [
                            {
                                    itemType: "group",
                                    colSpan: 2,
                                    items: [
                            {
                                itemType: "group",
                                caption: "General",
                                items: ["Name", "IsActive"]
                            },
                            {
                                itemType: "group",
                                caption: "Details",
                                items: [{
                                    dataField: "Description",
                                    editorType: "dxTextArea",
                                    editorOptions: {
                                        height: 100
                                    }
                                }]
                            }
                        ]     }
                        ]
                    }
                },

                // Columns
              columns: [
                    {
                        dataField: "Id",
                        width: 70,
                        allowEditing: false
                    },
                     {
                        dataField: "IsActive",
                        caption: "Active",
                        dataType: "boolean",
                        width: 80
                    },
                    {
                        dataField: "Name",
                        caption: "Task Name",
                        validationRules: [{ type: "required" }]
                    },
                    {
                        dataField: "Description",
                        visible: true
                    },
                    // --- เพิ่มส่วนนี้ ---
                    {
                        dataField: "LastStatus",
                        caption: "Status",
                        width: 100,
                        alignment: "center",
                        allowEditing: false, // ห้ามแก้ไขค่านี้
                        cellTemplate: function(container, options) {
                            var status = options.value;
                            if (!status) return;

                            var color = "grey";
                            if (status === "Success") color = "#28a745";      // สีเขียว
                            else if (status === "Failed") color = "#dc3545";  // สีแดง
                            else if (status === "Running") color = "#007bff"; // สีน้ำเงิน

                            $("<span>")
                                .css("color", color)
                                .css("font-weight", "bold")
                                .text(status)
                                .appendTo(container);
                        }
                    },
                    {
                        dataField: "LastExecutionTime",
                        caption: "Last Run",
                        dataType: "datetime",
                        format: "dd/MM/yyyy HH:mm",
                        width: 140,
                        allowEditing: false
                    },
                    {
                        dataField: "NextExecutionTime",
                        caption: "Next Run",
                        dataType: "datetime",
                        format: "dd/MM/yyyy HH:mm",
                        width: 140,
                        allowEditing: false
                    },
                    // ------------------
                   
                    {
                        dataField: "UpdatedAt",
                        caption: "Last Updated",
                        dataType: "datetime",
                        format: "dd/MM/yyyy HH:mm",
                        allowEditing: false,
                        width: 150
                    },
                       
        {
            type: "buttons",
            width: 150, // ปรับความกว้างเพิ่มเล็กน้อยให้พอดีปุ่ม
            buttons: [
                "edit",
                "delete",
                {
                    hint: "History",
                    icon: "clock",
                    onClick: function(e) {
                        showHistory(e.row.data.Id, e.row.data.Name);
                    }
                },
                // --- เพิ่มปุ่ม Step Logs ตรงนี้ ---
                {
                    hint: "Step Logs",
                    icon: "detailslayout",
                    onClick: function(e) {
                        showStepLogs(e.row.data.Id, e.row.data.Name);
                    }
                }
            ]
        }
        
                ],

                // Toolbar
                onToolbarPreparing: function(e) {
                    e.toolbarOptions.items.unshift({
                        location: "after",
                        widget: "dxButton",
                        options: {
                            icon: "refresh",
                            hint: "Refresh",
                            onClick: function() {
                                e.component.refresh();
                            }
                        }
                    });
                }
            });

            // ============ STEPS GRID ============
            function createStepsGrid(container, taskId) {
                var stepEditForm = null;

                $("<div>").dxDataGrid({
                    dataSource: {
                        store: stepsStore,
                        filter: ["TaskId", "=", taskId],
                        sort: [{ selector: "Order", desc: false }]
                    },
                    remoteOperations: true,
                    sorting: {
                        mode: "none"
                    },
                    showBorders: true,
                    columnAutoWidth: true,
                    rowDragging: {
                        allowReordering: true,
                        showDragIcons: true,
                        dropFeedbackMode: "push",
                        onReorder: function(e) {
                            if (e.fromIndex === e.toIndex) {
                                return;
                            }

                            var visibleRows = e.component.getVisibleRows();
                            var newOrder = visibleRows[e.toIndex].data.Order;
                            var deferred = $.Deferred();

                            stepsStore.update(e.itemData.Id, { Order: newOrder }).then(function() {
                                e.component.refresh().then(deferred.resolve, deferred.reject);
                            }, function(error) {
                                var errorMessage = error && error.responseText
                                    ? error.responseText
                                    : "Unable to reorder steps.";

                                DevExpress.ui.notify(errorMessage, "error", 3000);
                                deferred.reject(error);
                            });

                            e.promise = deferred.promise();
                        }
                    },

                    editing: {
                        mode: "popup",
                        allowAdding: true,
                        allowUpdating: true,
                        allowDeleting: true,
                        useIcons: true,
                        popup: {
                            title: "Step Configuration",
                            showTitle: true,
                            width: 800,
                            height: 650
                        },
                        form: {
                            onInitialized: function(args) {
                                stepEditForm = args.component;
                            },
                            onContentReady: function(args) {
                                stepEditForm = args.component;
                            },
                            items: [ {
                                    itemType: "group",
                                    colSpan: 2,
                                    items: [
                                {
                                    itemType: "group",
                                    caption: "Basic Info",
                                    colSpan: 2,
                                    items: [
                                        "Name","Description",
                                        "HttpMethod"
                                    ]
                                },
                                {
                                    itemType: "group",
                                    caption: "Request",
                                    colSpan: 2,
                                    items: [
                                        {
                                            dataField: "ApiUrl",
                                            editorOptions: {
                                                placeholder: "e.g. " + stepRequestEchoUrl
                                            }
                                        },
                                        {
                                            dataField: "Headers",
                                            editorType: "dxTextArea",
                                            editorOptions: {
                                                height: 90,
                                                placeholder: "Authorization: Bearer token\nX-Test-Id: sample\nContent-Type: application/json"
                                            }
                                        },
                                        {
                                            dataField: "Body",
                                            editorType: "dxTextArea",
                                            editorOptions: {
                                                height: 120,
                                                placeholder: '{"sample":true}'
                                            }
                                        },
                                        {
                                            colSpan: 2,
                                            template: function(data, itemElement) {
                                                $("<div>")
                                                    .dxButton({
                                                        text: "Test Request",
                                                        type: "default",
                                                        icon: "check",
                                                        onClick: function() {
                                                            if (!stepEditForm) {
                                                                return;
                                                            }

                                                            runStepRequestTest(getCurrentStepFormData(stepEditForm));
                                                        }
                                                    })
                                                    .appendTo(itemElement);
                                            }
                                        },
                                        {
                                            colSpan: 2,
                                            template: function(data, itemElement) {
                                                $("<div>")
                                                    .addClass("step-test-hint")
                                                    .text("Built-in echo URL for quick testing: " + stepRequestEchoUrl + "?statusCode=200")
                                                    .appendTo(itemElement);
                                            }
                                        }
                                    ]
                                }
                            ]
                            }
                            ]
                        }
                    },

                    columns: [
                        {
                            dataField: "Order",
                            caption: "Run Order",
                            width: 60,
                            dataType: "number",
                            allowEditing: false
                        },
                        {
                            dataField: "Name",
                            caption: "Step Name",
                            validationRules: [{ type: "required" }]
                        },
                         {
                            dataField: "Description",
                            caption: "Description",
                        },
                        {
                            dataField: "HttpMethod",
                            caption: "Method",
                            width: 100,
                            lookup: {
                                dataSource: ["GET", "POST", "PUT", "DELETE", "PATCH"]
                            },
                            validationRules: [{ type: "required" }]
                        },
                        {
                            dataField: "ApiUrl",
                            caption: "URL",
                            validationRules: [{ type: "required" }]
                        },
                        {
                            dataField: "Headers",
                            visible: false
                        },
                        {
                            dataField: "Body",
                            visible: false
                        },
                        {
                            type: "buttons",
                            width: 120,
                            buttons: [
                                {
                                    hint: "Test Request",
                                    icon: "check",
                                    onClick: function(e) {
                                        runStepRequestTest(e.row.data);
                                    }
                                },
                                "edit",
                                "delete"
                            ]
                        }
                    ],

                    onInitNewRow: function(e) {
                        e.data.TaskId = taskId;
                        e.data.HttpMethod = "GET";
                    }
                }).appendTo(container);
            }

            // ============ TRIGGERS GRID ============
            function createTriggersGrid(container, taskId) {
                scheduleGridEditor.render(container, taskId);
            }
                    // ============ STEP LOGS POPUP ============
        function showStepLogs(taskId, taskName) {
            var popup = $("#popupStepLogs").dxPopup({
                title: "Step Logs: " + taskName,
                visible: true,
                width: 1000,
                height: 650,
 
                contentTemplate: function(content) {
                    $("<div>").dxDataGrid({
                        dataSource: {
                            store: stepLogsStore,
                            // Filter ผ่าน Relation: TaskExecutionLog -> TaskId
                            filter: ["TaskExecutionLog.TaskId", "=", taskId],
                            sort: [{ selector: "StartTime", desc: true }]
                        },
                        remoteOperations: true,
                        showBorders: true,
                        columnAutoWidth: true,
                        rowAlternationEnabled: true,
                        height: "100%",
                scrolling: { mode: "virtual" },
                        columns: [
                            {
                                dataField: "StartTime",
                                caption: "Start Time",
                                dataType: "datetime",
                                format: "dd/MM/yyyy HH:mm:ss",
                                width: 160
                            },

                            {
                                dataField: "StepName",
                                caption: "Step Name",
                                width: 150
                            },
                            {
                                dataField: "Order",
                                caption: "#",
                                width: 50,
                                alignment: "center"
                            },
                            {
                                dataField: "Status",
                                caption: "Status",
                                width: 100,
                               
                                   cellTemplate: function(container, options) {
                            var status = options.value;
                            if (!status) return;

                            var color = "grey";
                            if (status === "Success") color = "#28a745";      // สีเขียว
                            else if (status === "Failed") color = "#dc3545";  // สีแดง
                            else if (status === "Error") color = "#dc3545";  // สีแดง
                            else if (status === "Running") color = "#007bff"; // สีน้ำเงิน

                            $("<span>")
                                .css("color", color)
                                .css("font-weight", "bold")
                                .text(status)
                                .appendTo(container);
                        }
                            },
                            {
                                dataField: "ResponseMessage",
                                caption: "Message",
                                // ให้ตัดข้อความถ้ายาวเกินไป
                                cellTemplate: function(container, options) {
                                    var text = options.value || "";
                                    $("<div>")
                                        .attr("title", text) // tooltip
                                        .text(text)
                                        .appendTo(container);
                                }
                            },
                            {
                                dataField: "EndTime",
                                caption: "End Time",
                                dataType: "datetime",
                                format: "HH:mm:ss",
                                width: 100,
                                visible: false // ซ่อนไว้ก่อน เปิดดูได้ถ้าต้องการ
                            }
                        ],

                     

                    }).appendTo(content);
                }
            }).dxPopup("instance");
        }
            // ============ HISTORY POPUP ============
            function showHistory(taskId, taskName) {
                $("#popupHistory").dxPopup({
                    title: "Execution History: " + taskName,
                    visible: true,
                     width: 1000,
                    height: 650,
                    contentTemplate: function(content) {
                        $("<div>").dxDataGrid({
                            dataSource: {
                                store: logsStore,
                                filter: ["TaskId", "=", taskId],
                                sort: [{ selector: "StartTime", desc: true }]
                            },
                            remoteOperations: true,
                            showBorders: true,
                            columnAutoWidth: true,
                            rowAlternationEnabled: true,

                            height: "100%",
                            scrolling: { mode: "virtual" },

                            columns: [
                                {
                                    dataField: "StartTime",
                                    caption: "Start Time",
                                    dataType: "datetime",
                                    format: "dd/MM/yyyy HH:mm:ss",
                                    width: 160
                                },
                                {
                                    dataField: "EndTime",
                                    caption: "End Time",
                                    dataType: "datetime",
                                    format: "HH:mm:ss",
                                    width: 100
                                },
                                {
                                    dataField: "Status",
                                    width: 100,
                              
                                    cellTemplate: function(container, options) {
                            var status = options.value;
                            if (!status) return;

                            var color = "grey";
                            if (status === "Success") color = "#28a745";      // สีเขียว
                            else if (status === "Failed") color = "#dc3545";  // สีแดง
                            else if (status === "Error") color = "#dc3545";  // สีแดง
                            else if (status === "Running") color = "#007bff"; // สีน้ำเงิน

                            $("<span>")
                                .css("color", color)
                                .css("font-weight", "bold")
                                .text(status)
                                .appendTo(container);
                        }
                                },
                                {
                                    dataField: "ResponseMessage",
                                    caption: "Message"
                                }
                            ]
                        }).appendTo(content);
                    },

                   
                });
            }
        });
    </script>
}
