<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <!--
        applicationInitialization: ให้ IIS ส่ง warmup request ไปยัง API ทันทีหลัง process start
        ทำงานร่วมกับ App Pool startMode=AlwaysRunning และ preloadEnabled=true
        เพื่อให้ SchedulerWorker (BackgroundService) เริ่มทำงานทันทีโดยไม่ต้องรอ HTTP request แรก
      -->
      <applicationInitialization doAppInitAfterRestart="true" skipManagedModules="true">
        <add initializationPage="/api/Tasks/Get?skip=0&amp;take=1" />
      </applicationInitialization>
    </system.webServer>
  </location>
</configuration>
